}

QLabel#DialogSubtitulo {
    font-size: 12px;
    font-weight: 700;
    color: rgba(17,24,39,0.56);
    margin: 0;
    padding: 0;
}

QLabel#DialogCV {
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(139, 92, 246, 0.14);
    border-radius: 14px;
    padding: 9px 12px;
    font-size: 12px;
    font-weight: 900;
    color: rgba(17,24,39,0.72);
}

QLabel#DialogInfo {
    color: #b91c1c;
    font-size: 12px;
    font-weight: 800;
}

QPushButton#DialogBtnSec {
    background: rgba(255,255,255,0.90);
    border: 1px solid rgba(148,163,184,0.28);
    border-radius: 14px;
    padding: 10px 16px;
    font-weight: 900;
    color: rgba(17,24,39,0.74);
    min-width: 110px;
}

QPushButton#DialogBtnSec:hover {
    background: rgba(243,244,246,0.95);
    border: 1px solid rgba(148,163,184,0.42);
}

QPushButton#DialogBtnOk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(245, 208, 254, 0.98),
        stop:0.55 rgba(167, 139, 250, 0.98),
        stop:1 rgba(124, 58, 237, 0.98)
    );
    border: 1px solid rgba(255,255,255,0.35);
    border-bottom: 3px solid rgba(91, 33, 182, 0.28);
    border-radius: 14px;
    padding: 10px 16px;
    font-weight: 950;
    color: #0b1220;
    min-width: 130px;
}

QPushButton#DialogBtnOk:hover {
    border: 1px solid rgba(255,255,255,0.58);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(250, 232, 255, 0.99),
        stop:0.55 rgba(221, 214, 254, 0.99),
        stop:1 rgba(167, 139, 250, 0.99)
    );
}

QPushButton#DialogBtnOk:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(196, 181, 253, 0.98),
        stop:0.55 rgba(167, 139, 250, 0.98),
        stop:1 rgba(109, 40, 217, 0.98)
    );
}

QPushButton#DialogBtnOk:disabled {
    background: rgba(229,231,235,0.80);
    border: 1px solid rgba(209,213,219,0.80);
    color: rgba(107,114,128,0.70);
}

/* ================================
   MENÚS
   ================================ */

QMenu {
    background: rgba(255,255,255,0.98);
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-radius: 14px;
    padding: 8px;
    color: #111827;
}

QMenu::item {
    background: transparent;
    border-radius: 10px;
    padding: 9px 14px;
    margin: 2px 0;
    font-size: 13px;
    font-weight: 800;
    color: rgba(17,24,39,0.78);
}

QMenu::item:selected {
    background: rgba(167, 139, 250, 0.18);
    border: 1px solid rgba(139, 92, 246, 0.28);
    color: #111827;
}

QMenu::item:disabled {
    color: rgba(107,114,128,0.55);
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background: rgba(139, 92, 246, 0.14);
    margin: 6px 8px;
}

