   DIÁLOGOS GENERALES
   ================================ */

QDialog#DialogoPremium {
    background: #f7f5ff;
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 22px;
}

QLabel#DialogTitulo {
    font-size: 22px;
    font-weight: 950;
