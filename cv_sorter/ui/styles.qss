QMainWindow {
    background: #eef2ff;
}

#Central {
    background: transparent;
}

QStackedWidget {
    background: transparent;
}

QWidget {
    color: #1f2937;
    font-family: Segoe UI;
    font-size: 14px;
}

QWidget#Pantalla {
    background: transparent;
}

/* ================================
   TARJETAS PRINCIPALES
   ================================ */

#Card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255,255,255,0.78),
        stop:1 rgba(255,255,255,0.62)
    );
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 30px;
    padding: 24px;
}

#HomeCard {
    background: rgba(255,255,255,0.84);
    border: 1px solid rgba(139, 92, 246, 0.10);
    border-radius: 28px;
}

/* ================================
   HOME
   ================================ */

#LabelTitulo {
    font-size: 48px;
    font-weight: 950;
    letter-spacing: 1px;
    color: #111827;
}

#LabelSubtitulo {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    color: #6b7280;
}

#LabelSubtituloMain {
    font-size: 18px;
    font-weight: 750;
    color: rgba(17, 24, 39, 0.52);
    margin-top: 6px;
}

#HomeHint {
    margin-top: 10px;
    color: rgba(124, 58, 237, 0.72);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
}

QFrame#HomeSep {
    border: none;
    border-top: 1px solid rgba(17,24,39,0.08);
    margin: 8px 10px 6px 10px;
}

QLabel#HomeSectionTitle {
    font-size: 12px;
    font-weight: 950;
    color: rgba(17,24,39,0.60);
    letter-spacing: 1.2px;
    margin-top: 8px;
    margin-bottom: 2px;
}

QPushButton#ChipBig {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.96),
        stop:0.55 rgba(248,245,255,0.96),
        stop:1 rgba(237,233,254,0.96)
    );
    border: 1px solid rgba(139, 92, 246, 0.14);
    border-bottom: 3px solid rgba(124, 58, 237, 0.14);
    border-radius: 18px;
    padding: 12px 16px;
    font-weight: 950;
    font-size: 14px;
    color: rgba(17,24,39,0.82);
}

QPushButton#ChipBig:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.99),
        stop:0.55 rgba(243,232,255,0.96),
        stop:1 rgba(221,214,254,0.96)
    );
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-bottom: 3px solid rgba(124, 58, 237, 0.22);
}

QPushButton#ChipBig:pressed {
    background: rgba(233, 213, 255, 0.88);
    border: 1px solid rgba(124, 58, 237, 0.42);
    border-bottom: 1px solid rgba(124, 58, 237, 0.30);
    padding-top: 13px;
    padding-bottom: 11px;
}

QPushButton#ChipSub {
    background: #ffffff;
    border: 1px solid rgba(17, 24, 39, 0.10);
    border-radius: 999px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 800;
    color: #111827;
}

QPushButton#ChipSub:hover {
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(124, 58, 237, 0.40);
}

QPushButton#ChipSub[disabledSoft="true"] {
    background: rgba(255, 255, 255, 0.6);
    color: #9ca3af;
    border: 1px solid rgba(156, 163, 175, 0.25);
}

QToolButton#ChipPill {
    background: rgba(255,255,255,0.95);
    border: 1px solid rgba(148,163,184,0.24);
    border-radius: 999px;
    padding: 8px 13px;
    font-weight: 950;
    font-size: 12px;
    color: rgba(17,24,39,0.74);
}

QToolButton#ChipPill:hover {
    background: rgba(243,232,255,0.86);
    border: 1px solid rgba(139, 92, 246, 0.32);
}

QToolButton#ChipPill:pressed {
    background: rgba(221,214,254,0.88);
    border: 1px solid rgba(124, 58, 237, 0.42);
}

/* ================================
   TOPBAR
   ================================ */

#TopBar {
    background: rgba(255, 255, 255, 0.35);
    border-bottom: 1px solid rgba(139, 92, 246, 0.12);
}

#TopBarTitle {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    color: rgba(17, 24, 39, 0.72);
}

/* ================================
   INPUTS GENERALES
   ================================ */

QLineEdit {
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(139, 92, 246, 0.20);
    border-radius: 18px;
    padding: 12px 14px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid rgba(124, 58, 237, 0.55);
}

QTextEdit {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(139, 92, 246, 0.20);
    border-radius: 14px;
    padding: 8px;
}

QTextEdit#DialogTextEdit {
    background: rgba(255,255,255,0.95);
    border: 1px solid rgba(139, 92, 246, 0.22);
    border-radius: 16px;
    padding: 10px;
    font-size: 14px;
    color: #111827;
}

QTextEdit#DialogTextEdit:focus {
    border: 1px solid rgba(124, 58, 237, 0.55);
}

/* ================================
   LISTAS
   ================================ */

QListWidget#ListaResultados {
    background: #f8f7ff;
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 16px;
    padding: 0px;
}

QListWidget {
    background: rgba(255, 255, 255, 0.80);
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-radius: 14px;
    padding: 8px;
}

QListWidget::item {
    border-radius: 10px;
    padding: 6px;
}

QListWidget::item:selected {
    background: rgba(167, 139, 250, 0.18);
    border: 1px solid rgba(167, 139, 250, 0.45);
}

QListWidget::item:hover {
    background: rgba(148, 163, 184, 0.10);
}

/* ================================
   BOTONES GENERALES
   ================================ */

QPushButton {
    border-radius: 16px;
    font-weight: 900;
    letter-spacing: 0.3px;
}

QPushButton#BotonPrimario,
QPushButton#BotonSecundario,
QPushButton#BotonAccent,
QPushButton#BotonPeligro {
    padding: 16px 22px;
    border: 1px solid rgba(255,255,255,0.22);
    border-bottom: 3px solid rgba(0,0,0,0.16);
}

QPushButton#BotonPrimario,
QPushButton#BotonSecundario,
QPushButton#BotonAccent {
    color: #0b1220;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.92),
        stop:0.55 rgba(221, 214, 254, 0.92),
        stop:1 rgba(139, 92, 246, 0.88)
    );
}

QPushButton#BotonPrimario:hover,
QPushButton#BotonSecundario:hover,
QPushButton#BotonAccent:hover {
    border: 1px solid rgba(255,255,255,0.35);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255, 255, 255, 0.95),
        stop:0.55 rgba(233, 213, 255, 0.92),
        stop:1 rgba(167, 139, 250, 0.92)
    );
}

QPushButton#BotonPrimario:pressed,
QPushButton#BotonSecundario:pressed,
QPushButton#BotonAccent:pressed {
    border-bottom: 1px solid rgba(0,0,0,0.22);
}

QPushButton#BotonAccent {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(124, 58, 237, 0.95),
        stop:0.55 rgba(167, 139, 250, 0.90),
        stop:1 rgba(139, 92, 246, 0.90)
    );
}

QPushButton#BotonPeligro {
    color: #0b1220;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 245, 245, 0.95),
        stop:0.55 rgba(254, 202, 202, 0.92),
        stop:1 rgba(248, 113, 113, 0.92)
    );
}

QPushButton#BotonPeligro:hover {
    border: 1px solid rgba(255,255,255,0.30);
}

QPushButton#BotonPeligro[variant="small"] {
    color: rgba(185, 28, 28, 0.95);
    font-size: 13px;
    font-weight: 950;
    border-radius: 14px;
    padding: 10px 16px;
    background: rgba(239, 68, 68, 0.10);
    border: 1px solid rgba(239, 68, 68, 0.30);
    border-bottom: 2px solid rgba(239, 68, 68, 0.16);
}

QPushButton#BotonPeligro[variant="small"]:hover {
    background: rgba(239, 68, 68, 0.16);
    border: 1px solid rgba(239, 68, 68, 0.42);
    border-bottom: 2px solid rgba(239, 68, 68, 0.22);
}

QPushButton#BotonPeligro[variant="small"]:pressed {
    background: rgba(239, 68, 68, 0.22);
    border: 1px solid rgba(239, 68, 68, 0.55);
    border-bottom: 1px solid rgba(239, 68, 68, 0.18);
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#BotonPrimario {
    color: #0b1220;
    font-size: 18px;
    font-weight: 950;
    letter-spacing: 0.4px;
    border-radius: 18px;
    padding: 10px 24px 12px 24px;
    min-height: 56px;
    border: 1px solid rgba(255,255,255,0.40);
    border-bottom: 4px solid rgba(91, 33, 182, 0.28);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.98),
        stop:0.30 rgba(245, 208, 254, 0.98),
        stop:0.68 rgba(196, 181, 253, 0.98),
        stop:1 rgba(139, 92, 246, 0.96)
    );
}

QPushButton#BotonPrimario:hover {
    border: 1px solid rgba(255,255,255,0.65);
    border-bottom: 4px solid rgba(91, 33, 182, 0.34);
    padding: 10px 24px 12px 24px;
    min-height: 56px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,1.0),
        stop:0.30 rgba(250, 232, 255, 1.0),
        stop:0.68 rgba(221, 214, 254, 0.99),
        stop:1 rgba(167, 139, 250, 0.98)
    );
}

QPushButton#BotonPrimario:pressed {
    border: 1px solid rgba(124, 58, 237, 0.30);
    border-bottom: 1px solid rgba(91, 33, 182, 0.20);
    padding: 11px 24px 9px 24px;
    min-height: 56px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(233, 213, 255, 0.98),
        stop:0.50 rgba(196, 181, 253, 0.98),
        stop:1 rgba(124, 58, 237, 0.96)
    );
}

QPushButton#BotonSecundario {
    color: #0b1220;
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 10px 16px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 950;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(245, 208, 254, 0.95),
        stop:0.55 rgba(167, 139, 250, 0.95),
        stop:1 rgba(124, 58, 237, 0.95)
    );
}

QPushButton#BotonSecundario:hover {
    border: 1px solid rgba(255,255,255,0.60);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(250, 232, 255, 0.98),
        stop:0.55 rgba(221, 214, 254, 0.98),
        stop:1 rgba(167, 139, 250, 0.98)
    );
}

QPushButton#BotonSecundario:pressed {
    border: 1px solid rgba(17,24,39,0.12);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(196, 181, 253, 0.95),
        stop:0.55 rgba(167, 139, 250, 0.95),
        stop:1 rgba(109, 40, 217, 0.95)
    );
}

QPushButton#BotonPrimarioPequeno {
    color: #0b1220;
    border: 1px solid rgba(255,255,255,0.35);
    border-bottom: 3px solid rgba(0,0,0,0.14);
    padding: 10px 16px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 950;
    min-width: 120px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(245, 208, 254, 0.98),
        stop:0.55 rgba(167, 139, 250, 0.98),
        stop:1 rgba(124, 58, 237, 0.98)
    );
}

QPushButton#BotonPrimarioPequeno:hover {
    border: 1px solid rgba(255, 255, 255, 0.60);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(250, 232, 255, 0.99),
        stop:0.55 rgba(221, 214, 254, 0.99),
        stop:1 rgba(167, 139, 250, 0.99)
    );
}

QPushButton#BotonPrimarioPequeno:pressed {
    border: 1px solid rgba(17,24,39,0.10);
    border-bottom: 1px solid rgba(0,0,0,0.20);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(196, 181, 253, 0.98),
        stop:0.55 rgba(167, 139, 250, 0.98),
        stop:1 rgba(109, 40, 217, 0.98)
    );
}

/* ================================
   STATUS BAR
   ================================ */

QStatusBar {
    background: transparent;
    border-top: 1px solid rgba(139, 92, 246, 0.12);
}

QStatusBar QLabel {
    color: rgba(124, 58, 237, 0.55);
    font-size: 11px;
    padding: 0 10px;
}

/* ================================
   RESULTADOS
   ================================ */

QWidget#ResultadoItem {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,0.96),
        stop:1 rgba(250,248,255,0.94)
    );
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-radius: 18px;
}

QWidget#ResultadoItem:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255,255,255,1.0),
        stop:1 rgba(245,240,255,0.98)
    );
    border: 1px solid rgba(139, 92, 246, 0.34);
}

QFrame#ResultadoAcento {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(167,139,250,1),
        stop:1 rgba(124,58,237,0.8)
    );
    border-radius: 2px;
}

QLabel#ResultadoTexto {
    color: #111827;
}

QPushButton#BotonAbrir {
    background-color: white;
    border: 1px solid #ddd;
    padding: 6px 12px;
    border-radius: 10px;
}
QPushButton#BotonAbrir:hover {
    background-color: #f3f0ff;
}

QPushButton#BotonAbrir:pressed {
    background: rgba(226,232,240,0.90);
}

QPushButton#BotonNotas {
    background: rgba(167, 139, 250, 0.18);
    border: 1px solid rgba(139, 92, 246, 0.55);
    border-radius: 12px;

    padding: 7px 16px;   /* 👈 antes 14 → ahora igual que estado */
    min-width: 90px;     /* 👈 CLAVE para igualarlo */

    font-weight: 950;
    font-size: 13px;
    color: #111827;
}

QPushButton#BotonNotas:hover {
    background: rgba(167, 139, 250, 0.28);
    border: 1px solid rgba(139, 92, 246, 0.70);
}

QPushButton#BotonNotas:pressed {
    background: rgba(167, 139, 250, 0.36);
}

QPushButton#BotonNotasActivo {
    background: rgba(124, 58, 237, 0.18);
    border: 1px solid rgba(124, 58, 237, 0.70);
    border-radius: 12px;

    padding: 7px 16px;
    min-width: 90px;

    font-weight: 950;
    font-size: 13px;
    color: #111827;
}

QPushButton#BotonNotasActivo:hover {
    background: rgba(124, 58, 237, 0.26);
}

QPushButton#BotonCliente {
    background: rgba(255,255,255,0.92);
    border: 1px solid rgba(245, 158, 11, 0.40);
    border-radius: 12px;
    padding: 7px 14px;
    font-weight: 900;
    font-size: 13px;
    color: #92400e;
}

QPushButton#BotonCliente:hover {
    background: rgba(254, 243, 199, 0.60);
    border: 1px solid rgba(245, 158, 11, 0.62);
}

QPushButton#BotonCliente:pressed {
    background: rgba(254, 243, 199, 0.85);
}

QPushButton#BotonClienteActivo {
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(5, 150, 105, 0.60);
    border-radius: 12px;
    padding: 7px 14px;
    font-weight: 950;
    font-size: 13px;
    color: #065f46;
}

QPushButton#BotonClienteActivo:hover {
    background: rgba(16, 185, 129, 0.24);
}

QLabel#HudResultados {
    color: rgba(17, 24, 39, 0.75);
    font-weight: 950;
    letter-spacing: 1px;
    padding: 6px 10px;
    border-radius: 10px;
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(139, 92, 246, 0.14);
}

/* ================================
   BUSCAR
   ================================ */

QWidget#BarraResumen {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(255,255,255,0.82),
        stop:1 rgba(248,245,255,0.78)
    );
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-radius: 18px;
}

QLabel#ResumenCount {
    font-weight: 950;
    font-size: 15px;
    color: rgba(17,24,39,0.88);
    padding-left: 2px;
}

QLabel#Pill {
    background: rgba(255,255,255,0.85);
    border: 1px solid rgba(139, 92, 246, 0.14);
    border-radius: 999px;
    padding: 4px 10px;
    font-weight: 900;
    font-size: 12px;
    color: rgba(17,24,39,0.70);
}

QWidget#HeaderLista {
    background: rgba(255,255,255,0.72);
    border: 1px solid rgba(139, 92, 246, 0.12);
    border-radius: 14px;
}

QComboBox#ComboOrden {
    background: rgba(255,255,255,0.90);
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 900;
    color: rgba(17,24,39,0.72);
}

QComboBox#ComboOrden:hover {
    border: 1px solid rgba(139, 92, 246, 0.35);
    background: rgba(243,232,255,0.72);
}

QComboBox#ComboOrden:focus {
    border: 1px solid rgba(124, 58, 237, 0.50);
}

QComboBox#ComboOrden::drop-down {
    border: none;
    width: 24px;
}

QComboBox#ComboOrden QAbstractItemView {
    background: white;
    border: 1px solid rgba(139, 92, 246, 0.20);
    selection-background-color: rgba(167, 139, 250, 0.20);
    selection-color: #111827;
}

QLabel#HeaderCol {
    color: rgba(17,24,39,0.60);
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 1.3px;
    text-transform: uppercase;
}

QWidget#ResultadosHeader {
    background: transparent;
}

QFrame#ResPill {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(167,139,250,0.95),
        stop:1 rgba(124,58,237,0.75)
    );
    border-radius: 10px;
}

QLabel#ResTitle {
    font-weight: 950;
    color: rgba(17,24,39,0.62);
    font-size: 12px;
    letter-spacing: 1px;
}

#TituloSistema {
    font-size: 22px;
    font-weight: 950;
    letter-spacing: 2px;
    color: #111827;
}

#SubtituloSistema {
    font-size: 13px;
    font-weight: 600;
    color: rgba(17,24,39,0.55);
}

QLabel#LabelCarpeta {
    background: rgba(167, 139, 250, 0.18);
    border: 1px solid rgba(139, 92, 246, 0.28);
    border-radius: 999px;
    padding: 4px 12px;
    font-weight: 900;
    font-size: 12px;
    color: #111827;
}

QPushButton#BotonCarpetaLimpiar {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #b91c1c;
    border-radius: 10px;
    font-weight: 900;
}

QPushButton#BotonCarpetaLimpiar:hover {
    background: rgba(239, 68, 68, 0.20);
}

QWidget#EmptyState {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(248,245,255,0.96),
        stop:1 rgba(243,232,255,0.88)
    );
    border: 1px dashed rgba(139, 92, 246, 0.30);
    border-radius: 22px;
}

QLabel#EmptyIcon {
    font-size: 34px;
}

QLabel#EmptyTitle {
    font-size: 17px;
    font-weight: 950;
    color: rgba(17,24,39,0.82);
}

QLabel#EmptyText {
    font-size: 12px;
    font-weight: 700;
    color: rgba(17,24,39,0.55);
    max-width: 420px;
}

QWidget#SidePanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255,255,255,0.74),
        stop:1 rgba(255,255,255,0.58)
    );
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-radius: 22px;
}
                           
QWidget#ClasificarPanel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255,255,255,0.78),
        stop:1 rgba(250,248,255,0.68)
    );
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-radius: 24px;
}

QLabel#ClasificarEstado {
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(139, 92, 246, 0.14);
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 12px;
    font-weight: 850;
    color: rgba(17,24,39,0.70);
}

QLabel#ClasificarResumen {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(255,255,255,0.88),
        stop:1 rgba(243,232,255,0.76)
    );
    border: 1px solid rgba(139, 92, 246, 0.16);
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 12px;
    font-weight: 900;
    color: rgba(17,24,39,0.76);
}

QListWidget#ClasificarLista {
    background: #f8f7ff;
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 16px;
    padding: 0px;
}

QListWidget#ClasificarLista::item {
