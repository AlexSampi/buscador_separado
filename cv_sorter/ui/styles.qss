    padding: 10px;
    font-size: 12px;
    font-weight: 800;
    color: rgba(17,24,39,0.60);
}

QPushButton#SideBtn {
    background: rgba(255,255,255,0.88);
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 14px;
    padding: 10px 12px;
    font-weight: 950;
    color: rgba(17,24,39,0.74);
}

QPushButton#SideBtn:hover {
    background: rgba(233, 213, 255, 0.55);
    border: 1px solid rgba(139, 92, 246, 0.34);
}

QPushButton#SideBtn:pressed {
    background: rgba(233, 213, 255, 0.78);
    border: 1px solid rgba(124, 58, 237, 0.45);
}

QPushButton#SideBtnDanger {
    background: rgba(239, 68, 68, 0.10);
    border: 1px solid rgba(239, 68, 68, 0.28);
    color: rgba(185, 28, 28, 0.95);
    border-radius: 14px;
    padding: 10px 12px;
    font-weight: 950;
}

QPushButton#SideBtnDanger:hover {
    background: rgba(239, 68, 68, 0.16);
    border: 1px solid rgba(239, 68, 68, 0.42);
}

QPushButton#SideBtnDanger:pressed {
    background: rgba(239, 68, 68, 0.22);
    border: 1px solid rgba(239, 68, 68, 0.58);
}

QToolButton#Chip {
    background: rgba(255,255,255,0.90);
    border: 1px solid rgba(148,163,184,0.35);
    border-radius: 999px;
    padding: 6px 12px;
    font-weight: 950;
    font-size: 12px;
    color: rgba(17,24,39,0.70);
}

QToolButton#Chip:hover {
    background: rgba(167, 139, 250, 0.18);
    border: 1px solid rgba(139, 92, 246, 0.45);
}

QToolButton#Chip:pressed {
    background: rgba(196, 181, 253, 0.35);
    border: 1px solid rgba(124, 58, 237, 0.55);
}

QPushButton#ScopeChip {
    background: rgba(255,255,255,0.85);
    border: 1px solid rgba(139, 92, 246, 0.18);
    border-radius: 14px;
    padding: 8px 14px;
    font-weight: 950;
    color: rgba(17,24,39,0.72);
    min-width: 64px;
}

QPushButton#ScopeChip:hover {
    background: rgba(243,232,255,0.72);
    border: 1px solid rgba(139, 92, 246, 0.35);
}

QPushButton#ScopeChip:checked {
    background: rgba(167, 139, 250, 0.24);
    border: 1px solid rgba(124, 58, 237, 0.55);
    color: rgba(17,24,39,0.90);
}

QRadioButton#ModoChip {
    spacing: 0px;
    padding: 7px 12px;
    border-radius: 999px;
    font-weight: 950;
    font-size: 12px;
    letter-spacing: 0.6px;
    color: rgba(17,24,39,0.70);
    background: rgba(255,255,255,0.70);
    border: 1px solid rgba(139, 92, 246, 0.18);
}

QRadioButton#ModoChip::indicator {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
    image: none;
}

QRadioButton#ModoChip:hover {
    background: rgba(233, 213, 255, 0.55);
    border: 1px solid rgba(139, 92, 246, 0.35);
}

QRadioButton#ModoChip:checked {
    background: rgba(167, 139, 250, 0.28);
    border: 1px solid rgba(124, 58, 237, 0.55);
    color: rgba(17,24,39,0.85);
}

QRadioButton#ModoChip:focus {
    border: 2px solid rgba(124, 58, 237, 0.55);
}

QLabel#ModoLabel {
    font-weight: 900;
    color: rgba(17,24,39,0.70);
    font-size: 12px;
}

QLabel#ModoHelp {
    font-size: 11px;
    font-weight: 800;
    color: rgba(17,24,39,0.55);
    margin-bottom: 4px;
}

QLabel#SideTipTitle {
    font-weight: 950;
